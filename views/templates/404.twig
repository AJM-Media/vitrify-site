{% extends 'layouts/base.twig' %}

{% block content %}
  <section class="relative z-1 px-6 sm:px-12 lg:px-16 py-32 text-white w-full min-h-[60vh] flex flex-col items-center justify-center text-center">
    <div class="max-w-xl mx-auto bg-white/10 backdrop-blur-md rounded-2xl border border-white/20 p-8 sm:p-12 shadow-lg">
      <h1 class="text-4xl sm:text-5xl font-semibold text-white mb-4">Page not found</h1>
      <p class="text-gray-300 text-lg mb-8">
        Sorry, we couldn't find what you're looking for. The page may have moved or no longer exists.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="{{ site.url }}" class="rounded-full bg-orange-400 px-6 py-3 text-sm font-semibold text-black shadow-md hover:bg-orange-300 transition">
          Back to home
        </a>
        <a href="{{ site.url }}/?s=" class="rounded-full border border-white/30 px-6 py-3 text-sm font-semibold text-white hover:bg-white/10 transition">
          Search
        </a>
      </div>
    </div>
  </section>
{% endblock %}
