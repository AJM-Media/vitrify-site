{% extends "layouts/base.twig" %}

{% block content %}
  <section class="max-w-6xl mx-auto py-12 px-6">
    <h1 class="text-4xl font-bold text-center text-gray-900 mb-10">Our Work</h1>
    
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {% for item in posts %}
        <article class="bg-white rounded-xl shadow p-6 hover:shadow-md transition">
          <h2 class="text-xl font-semibold mb-2">
            <a href="{{ item.link }}" class="text-blue-600 hover:underline">{{ item.title }}</a>
          </h2>
          <p class="text-gray-600">{{ item.preview.length(20) }}</p>
        </article>
      {% endfor %}
    </div>
  </section>
{% endblock %}
