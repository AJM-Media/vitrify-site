<!DOCTYPE html>
<html {{ site.language_attributes|default(function('language_attributes')) }}>
  {% block head %}
    {% include 'partials/head.twig' %}
  {% endblock %}

  <body class="bg-black text-white flex flex-col min-h-screen {{ body_class }}" x-data="{ open: false }">

    {{ function('wp_body_open') }}

    <!-- Background Blobs -->
    <div class="fixed inset-0 -z-10 pointer-events-none overflow-hidden">
      <!-- Top -->
      <div class="absolute inset-x-0 -top-40 sm:-top-80 blur-3xl">
        <div class="relative left-[calc(50%-11rem)] sm:left-[calc(50%-30rem)] aspect-1155/678 w-[36.125rem] sm:w-[72.1875rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-orange-400 to-red-500 opacity-30" style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"></div>
      </div>

      <!-- Bottom -->
      <div class="absolute inset-x-0 bottom-0 blur-3xl">
        <div class="relative left-[calc(50%+3rem)] sm:left-[calc(50%+36rem)] aspect-1155/678 w-[36.125rem] sm:w-[72.1875rem] -translate-x-1/2 bg-gradient-to-tr from-orange-400 to-red-500 opacity-30" style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"></div>
      </div>
    </div>

    <!-- Navigation -->
    <nav class="fixed top-4 left-1/2 -translate-x-1/2 z-50 max-w-[calc(100%-40px)] w-[calc(100%-40px)] mx-auto rounded-2xl bg-white/10 shadow-lg backdrop-blur-lg border border-white/20 px-6 py-3">
      <div class="flex items-center justify-between">

        <!-- Logo -->
        <a href="{{ site.url }}" class="flex items-center gap-3">
          <img class="h-8 w-auto" src="{{ site.theme_link }}/Logo-01.png" alt="{{ site.name }}">
          <span class="text-white text-lg font-semibold tracking-tight">{{ site.name }}</span>
        </a>

        <!-- Nav Links -->
        <div class="hidden sm:flex items-center gap-6">
          {% if menu and menu.items %}
            {% for item in menu.items %}
              <a href="{{ item.url }}" class="text-white hover:text-orange-300 font-medium transition {{ item.current ? 'text-orange-400' }}">{{ item.title }}</a>
            {% endfor %}
          {% else %}
            <a href="{{ site.url }}" class="text-white hover:text-orange-300 font-medium transition">Home</a>
            <a href="{{ site.url }}/about" class="text-white hover:text-orange-300 font-medium transition">About</a>
            <a href="{{ site.url }}/case-studies" class="text-white hover:text-orange-300 font-medium transition">Case Studies</a>
          {% endif %}
        </div>

        <!-- Search + CTA + Hamburger -->
        <div class="flex items-center gap-3 sm:gap-4">
          <form action="{{ site.url }}" method="get" class="hidden sm:block" role="search">
            <label for="nav-search" class="sr-only">Search</label>
            <input type="search" id="nav-search" name="s" placeholder="Search…" class="w-32 rounded-full bg-white/10 border border-white/20 px-3 py-1.5 text-sm text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent" value="{{ function('get_search_query') }}">
          </form>
          <a href="{{ site.url }}/contact" class="rounded-full bg-orange-400 px-5 py-2 text-sm font-semibold text-black shadow-md hover:bg-orange-300 transition">
            Let's Connect
          </a>
<button @click="open = true" class="lg:hidden p-2 rounded-md hover:bg-white/10 transition">
  <div class="h-3 w-3 overflow-hidden">
    <img src="https://img.icons8.com/ios-filled/50/ffffff/menu--v1.png" alt="Open menu" class="h-full w-full object-contain" />
  </div>
</button>


        </div>
      </div>
    </nav>

    <!-- Mobile Menu -->
    <div
      x-show="open"
      x-transition
      x-cloak
      @keydown.escape.window="open = false"
      @click.outside="open = false"
      class="lg:hidden fixed inset-0 z-50"
      aria-modal="true"
      role="dialog"
    >
      <div class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>

      <div class="absolute right-0 top-0 h-full w-full max-w-sm bg-gray-900 px-6 py-6 sm:ring-1 sm:ring-white/10">
        <div class="flex items-center justify-between">
          <a href="{{ site.url }}" class="-m-1.5 p-1.5">
            <span class="sr-only">{{ site.name }}</span>
            <img class="h-8 w-auto" src="{{ site.theme_link }}/Logo-01.png" alt="{{ site.name }}">
          </a>
<button @click="open = false" type="button" class="-m-2.5 rounded-md p-2.5">
  <img src="https://img.icons8.com/ios-filled/50/ffffff/multiply.png" alt="Close menu" class="h-2 w-2" />
</button>

        </div>

        <div class="mt-6 flow-root">
          <div class="-my-6 divide-y divide-white/10">
            <div class="space-y-2 py-6">
              {% if menu and menu.items %}
                {% for item in menu.items %}
                  <a href="{{ item.url }}" class="block rounded-lg px-3 py-2 text-base font-semibold text-white hover:bg-white/10">{{ item.title }}</a>
                {% endfor %}
              {% else %}
                <a href="{{ site.url }}" class="block rounded-lg px-3 py-2 text-base font-semibold text-white hover:bg-white/10">Home</a>
                <a href="{{ site.url }}/about" class="block rounded-lg px-3 py-2 text-base font-semibold text-white hover:bg-white/10">About</a>
                <a href="{{ site.url }}/case-studies" class="block rounded-lg px-3 py-2 text-base font-semibold text-white hover:bg-white/10">Case Studies</a>
                <a href="{{ site.url }}/contact" class="block rounded-lg px-3 py-2 text-base font-semibold text-white hover:bg-white/10">Contact</a>
              {% endif %}
              <form action="{{ site.url }}" method="get" class="pt-4 sm:hidden" role="search">
                <label for="mobile-search" class="sr-only">Search</label>
                <input type="search" id="mobile-search" name="s" placeholder="Search…" class="w-full rounded-lg bg-white/10 border border-white/20 px-4 py-2 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-orange-400">
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Page Content -->
    <section id="content" class="content-wrapper flex-grow">
      {% if title %}
        <h1>{{ title }}</h1>
      {% endif %}

      <div class="wrapper">
        {% block content %}
          Sorry, no content
        {% endblock %}
      </div>
    </section>

    <!-- Footer -->
    {% block footer %}
      {% include 'partials/footer.twig' %}
    {% endblock %}

    {{ function('wp_footer') }}
    {% do action('get_footer') %}

    <!-- Alpine -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  </body>
</html>