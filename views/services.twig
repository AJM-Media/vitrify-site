{% extends "layouts/base.twig" %}

{% block content %}
  <section class="relative z-1 px-6 sm:px-12 lg:px-16 py-24 text-white w-full">
    <div class="text-center max-w-4xl mx-auto mb-16">
      <h1 class="text-5xl sm:text-6xl font-semibold mb-6">{{ post.title|default('Our Services') }}</h1>
      {% if post.content %}
        <div class="text-xl text-gray-300 leading-relaxed prose prose-invert max-w-none">
          {{ post.content }}
        </div>
      {% endif %}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10 max-w-7xl mx-auto">
      {% set services = post.meta('services') %}
      {% if services and services|length > 0 %}
        {% for service in services %}
          <div class="bg-white/10 backdrop-blur-md rounded-xl p-6 border border-white/20 shadow-md hover:shadow-lg transition">
            {% if service.icon %}
              <div class="mb-4">
                <img src="{{ service.icon.url }}" alt="" class="w-12 h-12 object-contain" />
              </div>
            {% endif %}
            <h2 class="text-xl font-semibold text-orange-400 mb-2">{{ service.title|default('Service') }}</h2>
            <p class="text-gray-300 text-sm leading-relaxed">{{ service.description|default('') }}</p>
          </div>
        {% endfor %}
      {% else %}
        {# Fallback when no ACF data #}
        {% set default_services = [
          { title: 'Strategy', description: 'Research, positioning, and roadmaps that align your brand with measurable outcomes.' },
          { title: 'Design', description: 'Visual identity, UX, and interface design that looks great and works even better.' },
          { title: 'Development', description: 'Web and product development built for scale, performance, and maintainability.' }
        ] %}
        {% for service in default_services %}
          <div class="bg-white/10 backdrop-blur-md rounded-xl p-6 border border-white/20 shadow-md hover:shadow-lg transition">
            <h2 class="text-xl font-semibold text-orange-400 mb-2">{{ service.title }}</h2>
            <p class="text-gray-300 text-sm leading-relaxed">{{ service.description }}</p>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </section>
{% endblock %}
