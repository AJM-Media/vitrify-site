{% extends 'layouts/base.twig' %}

{% block content %}
  <section class="relative z-1 px-6 sm:px-12 lg:px-16 py-24 text-white w-full max-w-5xl mx-auto">
    <h1 class="text-4xl sm:text-5xl font-semibold mb-4">Search results</h1>
    <p class="text-gray-300 mb-12">{% if title %}{{ title }}{% else %}Results for your search.{% endif %}</p>

    {% if posts and posts|length > 0 %}
      <div class="space-y-8">
        {% for post in posts %}
          {% include ['partials/tease-' ~ post.type ~ '.twig', 'partials/tease.twig'] %}
        {% endfor %}
      </div>
      {% if posts.pagination is defined and posts.pagination.pages is not empty %}
        {% include 'partials/pagination.twig' with {
          pagination: posts.pagination({
            show_all: false,
            mid_size: 3,
            end_size: 2
          })
        } %}
      {% endif %}
    {% else %}
      <div class="bg-white/10 backdrop-blur-md rounded-xl border border-white/20 p-8 text-center">
        <p class="text-gray-300">No results found. Try a different search or <a href="{{ site.url }}" class="text-orange-400 hover:text-orange-300">return home</a>.</p>
      </div>
    {% endif %}
  </section>
{% endblock %}
