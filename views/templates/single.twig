{% extends 'layouts/base.twig' %}

{% block content %}
  <section class="relative z-1 px-6 sm:px-12 lg:px-16 py-24 text-white w-full">
    <article class="post-type-{{ post.type }} max-w-4xl mx-auto" id="post-{{ post.id }}">
      {% if post.thumbnail %}
        <img src="{{ post.thumbnail.src('large') }}" alt="{{ post.title }}" class="rounded-xl border border-white/20 shadow-lg mb-8 w-full object-cover" />
      {% endif %}
      <h1 class="text-4xl sm:text-5xl font-semibold text-white mb-4">{{ post.title }}</h1>
      <p class="text-gray-400 text-sm mb-8">
        <span>By</span>
        <a href="{{ post.author.link }}" class="text-orange-400 hover:text-orange-300">{{ post.author.name }}</a>
        <span>&bull;</span>
        <time datetime="{{ post.date|date('Y-m-d H:i:s') }}">{{ post.date|date('F j, Y') }}</time>
      </p>
      <div class="prose prose-invert max-w-none text-gray-300">
        {{ post.content }}
      </div>
      <section class="mt-12 pt-8 border-t border-white/20">
        {% if post.comments %}
          <h3 class="text-xl font-semibold text-white mb-4">Comments</h3>
          {% for cmt in post.comments %}
            {% include 'partials/comment.twig' with { comment: cmt } %}
          {% endfor %}
        {% endif %}
        {% if post.comment_status != 'closed' %}
          {% include 'partials/comment-form.twig' %}
        {% else %}
          <p class="text-gray-400 text-sm">Comments for this post are closed.</p>
        {% endif %}
      </section>
    </article>
  </section>
{% endblock %}
